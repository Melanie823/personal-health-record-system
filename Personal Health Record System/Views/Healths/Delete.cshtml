@model Personal_Health_Record_System.Models.Health

@{
    ViewData["Title"] = "Delete";
}

<h1 class="text-center text-danger my-4">Delete Health Record</h1>

<h3 class="text-center">Are you sure you want to delete this record?</h3>
<div class="card shadow p-4 mb-5 bg-white rounded">
    <div class="card-body">
        <h4 class="card-title text-secondary">Health Information</h4>
        <hr />
        <dl class="row">
            <dt class="col-sm-3 fw-bold">
                @Html.DisplayNameFor(model => model.Account)
            </dt>
            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.Account)
            </dd>
            <dt class="col-sm-3 fw-bold">
                @Html.DisplayNameFor(model => model.SystolicPressure)
            </dt>
            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.SystolicPressure)
            </dd>
            <dt class="col-sm-3 fw-bold">
                @Html.DisplayNameFor(model => model.DiastolicPressure)
            </dt>
            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.DiastolicPressure)
            </dd>
            <dt class="col-sm-3 fw-bold">
                @Html.DisplayNameFor(model => model.BloodOxygen)
            </dt>
            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.BloodOxygen)
            </dd>
            <dt class="col-sm-3 fw-bold">
                @Html.DisplayNameFor(model => model.HeartRate)
            </dt>
            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.HeartRate)
            </dd>
            <dt class="col-sm-3 fw-bold">
                @Html.DisplayNameFor(model => model.BodyTemperature)
            </dt>
            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.BodyTemperature)
            </dd>
            <dt class="col-sm-3 fw-bold">
                @Html.DisplayNameFor(model => model.FastingBloodSugar)
            </dt>
            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.FastingBloodSugar)
            </dd>
            <dt class="col-sm-3 fw-bold">
                @Html.DisplayNameFor(model => model.PostMealBloodSugar)
            </dt>
            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.PostMealBloodSugar)
            </dd>
            <dt class="col-sm-3 fw-bold">
                @Html.DisplayNameFor(model => model.SleepDuration)
            </dt>
            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.SleepDuration)
            </dd>
            <dt class="col-sm-3 fw-bold">
                @Html.DisplayNameFor(model => model.IsExercise)
            </dt>
            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.IsExercise)
            </dd>
            <dt class="col-sm-3 fw-bold">
                @Html.DisplayNameFor(model => model.Breakfast)
            </dt>
            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.Breakfast)
            </dd>
            <dt class="col-sm-3 fw-bold">
                @Html.DisplayNameFor(model => model.Lunch)
            </dt>
            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.Lunch)
            </dd>
            <dt class="col-sm-3 fw-bold">
                @Html.DisplayNameFor(model => model.Dinner)
            </dt>
            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.Dinner)
            </dd>
            <dt class="col-sm-3 fw-bold">
                @Html.DisplayNameFor(model => model.RecordDate)
            </dt>
            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.RecordDate)
            </dd>
        </dl>

        <form asp-action="Delete" class="text-center mt-4">
            <input type="hidden" asp-for="Id" />
            <input type="submit" value="刪除" class="btn btn-danger px-5" />
            <a asp-action="Index" class="btn btn-outline-secondary px-5">🔙 回到列表</a>
        </form>
    </div>
</div>
