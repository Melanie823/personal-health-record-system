@model Personal_Health_Record_System.Models.Health

@{
    ViewData["Title"] = "Health Analysis";
}

<h1 class="text-center text-primary my-4" style="font-family: 'Segoe UI', sans-serif; font-size: 2.5rem; color: #6c757d;">
    🌿 Health Analysis
</h1>

<div class="card shadow-lg p-4 mb-5 rounded" style="background: linear-gradient(135deg, #f8f9fa, #e9ecef);">
    <div class="card-body">
        <h4 class="card-title text-secondary" style="font-family: 'Segoe UI', sans-serif;">
            🩺 Analysis Results
        </h4>
        <hr />
        <ul class="list-unstyled">
            @foreach (var item in ViewBag.Analysis)
            {
                <li class="alert alert-light text-danger shadow-sm p-3 mb-2 rounded" style="border-left: 5px solid #dc3545;">
                    <i class="fas fa-heartbeat text-danger me-2"></i> @item
                </li>
            }
        </ul>
    </div>
</div>

<div class="text-center mt-4">
    <a asp-action="Index" class="btn btn-outline-secondary px-5 py-2" style="font-size: 1.1rem; border-radius: 25px; background-color: #f8d7da; color: #721c24;">
        🔙 回到列表
    </a>
</div>
