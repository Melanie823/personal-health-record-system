@model Personal_Health_Record_System.Models.Health

@{
    ViewData["Title"] = "Edit";
}

<h1 class="text-center text-primary my-4">Edit Health Record</h1>

<div class="card shadow p-4 mb-5 bg-white rounded">
    <div class="card-body">
        <h4 class="card-title text-secondary">Health Information</h4>
        <hr />
        <div class="row justify-content-center">
            <div class="col-md-6">
                <form asp-action="Edit">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <input type="hidden" asp-for="Id" />

                    <div class="form-group mb-3">
                        <label asp-for="Account" class="form-label fw-bold"></label>
                        <input asp-for="Account" class="form-control" readonly />
                        <span asp-validation-for="Account" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="SystolicPressure" class="form-label fw-bold"></label>
                        <input asp-for="SystolicPressure" class="form-control" />
                        <span asp-validation-for="SystolicPressure" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="DiastolicPressure" class="form-label fw-bold"></label>
                        <input asp-for="DiastolicPressure" class="form-control" />
                        <span asp-validation-for="DiastolicPressure" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="BloodOxygen" class="form-label fw-bold"></label>
                        <input asp-for="BloodOxygen" class="form-control" />
                        <span asp-validation-for="BloodOxygen" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="HeartRate" class="form-label fw-bold"></label>
                        <input asp-for="HeartRate" class="form-control" />
                        <span asp-validation-for="HeartRate" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="BodyTemperature" class="form-label fw-bold"></label>
                        <input asp-for="BodyTemperature" class="form-control" />
                        <span asp-validation-for="BodyTemperature" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="FastingBloodSugar" class="form-label fw-bold"></label>
                        <input asp-for="FastingBloodSugar" class="form-control" />
                        <span asp-validation-for="FastingBloodSugar" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="PostMealBloodSugar" class="form-label fw-bold"></label>
                        <input asp-for="PostMealBloodSugar" class="form-control" />
                        <span asp-validation-for="PostMealBloodSugar" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="SleepDuration" class="form-label fw-bold"></label>
                        <input asp-for="SleepDuration" class="form-control" />
                        <span asp-validation-for="SleepDuration" class="text-danger"></span>
                    </div>

                    <div class="form-check mb-3">
                        <input class="form-check-input" asp-for="IsExercise" />
                        <label class="form-check-label">
                            @Html.DisplayNameFor(model => model.IsExercise)
                        </label>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="Breakfast" class="form-label fw-bold"></label>
                        <input asp-for="Breakfast" class="form-control" />
                        <span asp-validation-for="Breakfast" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="Lunch" class="form-label fw-bold"></label>
                        <input asp-for="Lunch" class="form-control" />
                        <span asp-validation-for="Lunch" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="Dinner" class="form-label fw-bold"></label>
                        <input asp-for="Dinner" class="form-control" />
                        <span asp-validation-for="Dinner" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="RecordDate" class="form-label fw-bold"></label>
                        <input asp-for="RecordDate" class="form-control" type="date" />
                        <span asp-validation-for="RecordDate" class="text-danger"></span>
                    </div>

                    <div class="text-center mt-4">
                        <button type="submit" class="btn btn-primary px-5">儲存</button>
                        <a asp-action="Index" class="btn btn-outline-secondary px-5 ms-2">取消</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
