@model IEnumerable<Personal_Health_Record_System.Models.Health>

@{
    ViewData["Title"] = "Index";
}

<h1>個人資料歷史紀錄</h1>
<div class="d-flex align-items-center mb-3">
    <a href="/Home/Login" class="btn btn-outline-primary me-2">首頁</a>
    <a asp-action="Create" class="btn btn-success">新增</a>
</div>

<!-- 篩選表單 -->
<form asp-action="Filter" method="get" class="d-flex flex-wrap align-items-center mb-4 bg-light p-3 rounded shadow-sm">
    <div class="me-3">
        <label for="startDate" class="form-label">開始日期：</label>
        <input type="date" id="startDate" name="startDate" class="form-control" />
    </div>

    <div class="me-3">
        <label for="endDate" class="form-label">結束日期：</label>
        <input type="date" id="endDate" name="endDate" class="form-control" />
    </div>

    <div class="me-3">
        <label for="isExercise" class="form-label">是否有運動：</label>
        <select id="isExercise" name="isExercise" class="form-select">
            <option value="">-- 全部 --</option>
            <option value="true">有運動</option>
            <option value="false">無運動</option>
        </select>
    </div>

    <div class="mt-4">
        <button type="submit" class="btn btn-primary me-2">篩選</button>
        <a href="/Healths" class="btn btn-outline-secondary">回到列表</a>
    </div>
</form>

<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Account)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.SystolicPressure)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DiastolicPressure)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.BloodOxygen)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.HeartRate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.SleepDuration)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.IsExercise)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.RecordDate)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Account)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.SystolicPressure)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.DiastolicPressure)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.BloodOxygen)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.HeartRate)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.SleepDuration)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.IsExercise)
                </td>                
                <td>
                    @Html.DisplayFor(modelItem => item.RecordDate)
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm">編輯</a>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info btn-sm">詳情</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm">刪除</a>
                </td>
            </tr>
        }
    </tbody>
</table>
