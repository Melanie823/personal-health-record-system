@{
    ViewData["Title"] = "Home Page";
}

<div class="d-flex justify-content-center align-items-center vh-100 bg-light">
    <div class="card p-5 shadow-lg" style="width: 400px;">
        <div class="text-center mb-4">
            <h2 class="mt-3">個人健康紀錄系統</h2>
            <p class="text-muted">請登入以繼續</p>
        </div>
        <form method="post" asp-action="Index">
            <div class="form-group mb-3">
                <label for="account">帳號(身分證字號)</label>
                <input type="text" name="account" class="form-control" required />
            </div>
            <div class="form-group mb-4">
                <label for="password">密碼</label>
                <input type="password" name="password" class="form-control" required />
            </div>
            <button type="submit" class="btn btn-primary w-100">登入</button>

            @if (ViewBag.ErrorMessage != null)
            {
                <div class="text-danger">
                    @ViewBag.ErrorMessage
                </div>
            }
        </form>
        <div class="text-center mt-4">
            <p class="text-secondary">還沒有帳號嗎？ <a href="/personals/Create" class="text-primary">註冊</a></p>
        </div>
    </div>
</div>


